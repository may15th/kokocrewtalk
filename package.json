{
  "name": "kokocrew-talk-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check": "node --check cloudflare/worker.js && node --check cloudflare/client.js",
    "test": "python -B tests/test_cloudflare_schema.py",
    "test:live": "node tests/cloudflare-live.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "ws": "^8.22.1"
  }
}
